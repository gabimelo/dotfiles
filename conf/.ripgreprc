--smart-case
--follow
--hidden

--type-add=proto:*.proto
--type-add=bazel:BUILD*
--type-add=bazel:*.bzl
--type-add=bazel:WORKSPACE*
--type-add=starlark:*.bzl
--type-add=starlark:*.star

--glob=!.git/
--glob=!node_modules/
--glob=!.venv/
--glob=!venv/
--glob=!__pycache__/
--glob=!.mypy_cache/
--glob=!.pytest_cache/
--glob=!.tox/
--glob=!bazel-bin/
--glob=!bazel-out/
--glob=!bazel-testlogs/
--glob=!bazel-*/
--glob=!*.egg-info/
--glob=!build/
--glob=!dist/
--glob=!.dvc/
--glob=!tmp/
--glob=!*.pyc
--glob=!*.pyo
--glob=!*.csv
--glob=!*.parquet
--glob=!*.jar
